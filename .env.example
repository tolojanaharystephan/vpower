# Environment Variables — VPower777
# Copy to .env and fill values. Never commit real secrets.

# --- Runtime ---
NODE_ENV=development
APP_NAME=vpower777
APP_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
API_URL=http://localhost:4000
API_PORT=4000

# Frontend (Next.js public)
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Database ---
# Docker Compose defaults (see docker-compose.yml)
DATABASE_URL=postgresql://vpower777:vpower777@127.0.0.1:5432/vpower777

# Native local alternative example:
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/vpower777

# --- Redis ---
REDIS_URL=redis://127.0.0.1:6379

# --- Auth (Phase 3) ---
JWT_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Legacy generic game API (unused when VBlink is enabled) ---
GAME_API_BASE_URL=
GAME_API_KEY=
GAME_API_SECRET=
GAME_API_TIMEOUT=10000
GAME_PROVIDER_MODE=client

# --- VBlink FastAPI (PDF) — never commit real secrets ---
# API Server Domain ≠ Game Mainpage. www.vblink777.club is the lobby only.
# VBLINK_API_BASE_URL must be the FastAPI host from the PDF "Preparations" page.
VBLINK_ENABLED=true
VBLINK_API_BASE_URL=
VBLINK_APP_ID=
VBLINK_APP_SECRET=
VBLINK_ENCRYPTION_KEY=change-me-vblink-encryption-key-32chars
VBLINK_AGENT_ACCOUNT=
VBLINK_LOBBY_URL=https://www.vblink777.club
VBLINK_TIMEOUT_MS=15000

# --- 100Plus game provider — never commit real secrets ---
PLUS100_API_URL=
PLUS100_AGENT_ID=
PLUS100_SECRET_KEY=

# --- Translation (Phase 11) ---
GOOGLE_TRANSLATION_API_KEY=
TRANSLATION_ENABLED=false

# --- Feature flags ---
PAYMENTS_ENABLED=false
LIVE_GAMES_ENABLED=false

# --- Observability ---
SENTRY_DSN=
LOG_LEVEL=info

# --- Admin bootstrap (Phase 5 — optional; leave empty to skip) ---
SEED_ADMIN_EMAIL=admin@vpower777.local
SEED_ADMIN_PASSWORD=ChangeMeAdmin123!
SEED_ADMIN_ROLE=SUPER_ADMIN
