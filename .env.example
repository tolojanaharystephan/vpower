# Environment Variables — VPower777
# Copy to .env and fill values. Never commit real secrets.
#
# Docker Compose (production / staging):
#   docker compose up -d --build
# Hostnames postgres/redis are Docker DNS names inside the network.
#
# Local native/dev (without Docker app containers):
#   DATABASE_URL=postgresql://vpower777:vpower777@127.0.0.1:5432/vpower777
#   REDIS_URL=redis://127.0.0.1:6379
#   API_PORT=4000
#   NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Runtime ---
NODE_ENV=production
APP_NAME=vpower777
APP_URL=https://staging.vpower777.fun
ADMIN_URL=https://staging.vpower777.fun
API_URL=https://staging.vpower777.fun
API_PORT=3000

# Frontend (Next.js public — baked at image build time via compose build args)
NEXT_PUBLIC_API_URL=https://staging.vpower777.fun

# --- Postgres (compose service) ---
POSTGRES_USER=vpower777
POSTGRES_PASSWORD=vpower777
POSTGRES_DB=vpower777
DATABASE_URL=postgresql://vpower777:vpower777@postgres:5432/vpower777

# --- Redis (compose service; required by API) ---
REDIS_URL=redis://redis:6379

# --- Auth ---
JWT_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Legacy generic game API (unused when VBlink is enabled) ---
GAME_API_BASE_URL=
GAME_API_KEY=
GAME_API_SECRET=
GAME_API_TIMEOUT=10000
GAME_PROVIDER_MODE=client

# --- VBlink FastAPI — never commit real secrets ---
# API Server Domain ≠ Game Mainpage. www.vblink777.club is the lobby only.
# VBLINK_API_BASE_URL must be the FastAPI host (with https://).
VBLINK_ENABLED=true
VBLINK_API_BASE_URL=https://www.vblink777.club
VBLINK_APP_ID=Gf0lwLAG431qx7107
VBLINK_APP_SECRET=MafJsD_P8rlvVZuhplr5ml3cf6
VBLINK_ENCRYPTION_KEY=change-me-vblink-encryption-key-32chars
VBLINK_AGENT_ACCOUNT=BSBM001
VBLINK_LOBBY_URL=https://www.vblink777.club
VBLINK_TIMEOUT_MS=15000

